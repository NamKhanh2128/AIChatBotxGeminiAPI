<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.training.studyfx.controller.LoginController"
            styleClass="auth-container">

    <!-- Ambient glow blobs -->
    <Circle radius="200" fill="rgba(98,68,212,0.07)"
             translateX="-80" translateY="-60"
             AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0"
             mouseTransparent="true"/>
    <Circle radius="140" fill="rgba(0,196,232,0.05)"
             AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"
             translateX="80" translateY="60"
             mouseTransparent="true"/>

    <!-- Center card -->
    <VBox alignment="CENTER"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox fx:id="loginCard" alignment="CENTER" spacing="20"
              styleClass="auth-card" maxWidth="400">

            <!-- Icon -->
            <VBox alignment="CENTER" spacing="10">
                <StackPane alignment="CENTER">
                    <Circle radius="38" fill="rgba(59,130,246,0.1)"
                             stroke="rgba(59,130,246,0.3)" strokeWidth="1.5"/>
                    <Circle radius="30"
                             style="-fx-fill: linear-gradient(from 0% 0% to 100% 100%, #3b82f6, #06b6d4);"/>
                    <Label text="💬" style="-fx-font-size: 24px;"/>
                </StackPane>
                <Label text="Internal Chat" styleClass="auth-title"/>
                <Label text="Sign in to continue" styleClass="auth-subtitle"/>
            </VBox>

            <Rectangle height="1" width="300" fill="rgba(255,255,255,0.05)"/>

            <!-- Username -->
            <VBox alignment="CENTER_LEFT" spacing="7">
                <Label text="Username" styleClass="auth-label"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           styleClass="auth-field" maxWidth="Infinity"/>
            </VBox>

            <!-- Password -->
            <VBox alignment="CENTER_LEFT" spacing="7">
                <Label text="Password" styleClass="auth-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               styleClass="auth-field" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="errorLabel" visible="false" wrapText="true"
                   maxWidth="300" styleClass="auth-error"/>

            <!-- Buttons -->
            <VBox alignment="CENTER" spacing="10">
                <Button fx:id="loginButton" defaultButton="true"
                        onAction="#handleLogin" text="Sign In  →"
                        prefHeight="48" maxWidth="Infinity"
                        styleClass="auth-btn-primary"/>
                <Button fx:id="registerButton"
                        onAction="#handleShowRegister" text="Create an Account"
                        prefHeight="44" maxWidth="Infinity"
                        styleClass="auth-btn-secondary"/>
            </VBox>

            <Label text="Internal Chat · HUST OOP Project"
                   style="-fx-font-size: 11px; -fx-text-fill: #1e293b;"/>
        </VBox>
    </VBox>
</AnchorPane>
