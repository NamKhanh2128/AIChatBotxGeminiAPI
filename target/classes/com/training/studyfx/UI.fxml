<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="760.0" prefWidth="1280.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.training.studyfx.controller.UIController">

    <!-- ════════════════ LEFT: Collapsible Sidebar ════════════════ -->
    <left>
        <VBox fx:id="sidebar"
              prefWidth="250.0" minWidth="250.0" maxWidth="250.0"
              alignment="TOP_CENTER"
              styleClass="side-bar">

            <!-- Profile Section -->
            <VBox fx:id="profileSection" spacing="12" alignment="CENTER"
                  styleClass="sidebar-profile-section">
                <StackPane alignment="CENTER">
                    <!-- Gradient ring — uses CSS class, no inline fill -->
                    <Circle radius="46" styleClass="sidebar-avatar-ring"/>
                    <Circle radius="41" styleClass="sidebar-avatar-inner"/>
                    <Circle fx:id="avt" styleClass="sidebar-avatar-circle" radius="37.0"/>
                    <Label text="👤" styleClass="sidebar-avatar-icon"/>
                </StackPane>
                <Label fx:id="profileName" text="You"
                       styleClass="sidebar-profile-name"/>
                <HBox fx:id="profileStatusBox" alignment="CENTER" spacing="7"
                      styleClass="sidebar-status-box">
                    <Circle radius="4" styleClass="sidebar-status-dot"
                             style="-fx-effect: dropshadow(three-pass-box, rgba(34,197,94,0.6), 5, 0, 0, 0);"/>
                    <Label text="Active now" styleClass="sidebar-status-label"/>
                </HBox>
            </VBox>

            <Region prefHeight="14"/>

            <!-- MENU label -->
            <HBox fx:id="menuLabelBox" alignment="CENTER_LEFT"
                  styleClass="sidebar-menu-label"
                  style="-fx-padding: 0 0 4 16;">
                <Label text="MENU" styleClass="sidebar-menu-text"/>
            </HBox>

            <!-- ── About ── -->
            <Button fx:id="About" maxWidth="Infinity" styleClass="nav-button"
                    onAction="#handleAboutClick" pickOnBounds="true">
                <graphic>
                    <HBox styleClass="nav-btn-content" pickOnBounds="true">
                        <Label text="ℹ" styleClass="nav-icon"/>
                        <Label fx:id="aboutLabel" styleClass="nav-label" text="About"/>
                    </HBox>
                </graphic>
                <tooltip><Tooltip text="About"/></tooltip>
            </Button>

            <!-- ── Global Chat ── -->
            <Button fx:id="Chat" maxWidth="Infinity" styleClass="nav-button"
                    onAction="#handleChatClick" pickOnBounds="true">
                <graphic>
                    <HBox styleClass="nav-btn-content" pickOnBounds="true">
                        <Label text="🌐" styleClass="nav-icon"/>
                        <Label fx:id="chatLabel" styleClass="nav-label" text="Global Chat"/>
                    </HBox>
                </graphic>
                <tooltip><Tooltip text="Global Chat"/></tooltip>
            </Button>

            <!-- ── Chatbot AI ── -->
            <Button fx:id="Chatbot" maxWidth="Infinity" styleClass="nav-button"
                    onAction="#handleChatbotClick" pickOnBounds="true">
                <graphic>
                    <HBox styleClass="nav-btn-content" pickOnBounds="true">
                        <Label text="✨" styleClass="nav-icon"/>
                        <Label fx:id="chatbotLabel" styleClass="nav-label" text="Chatbot AI"/>
                    </HBox>
                </graphic>
                <tooltip><Tooltip text="Chatbot AI"/></tooltip>
            </Button>

            <!-- ── Settings ── -->
            <Button fx:id="Setting" maxWidth="Infinity" styleClass="nav-button"
                    onAction="#handleSettingClick" pickOnBounds="true">
                <graphic>
                    <HBox styleClass="nav-btn-content" pickOnBounds="true">
                        <Label text="⚙" styleClass="nav-icon"/>
                        <Label fx:id="settingLabel" styleClass="nav-label" text="Settings"/>
                    </HBox>
                </graphic>
                <tooltip><Tooltip text="Settings"/></tooltip>
            </Button>

            <!-- Spacer -->
            <Pane VBox.vgrow="ALWAYS"/>

            <!-- ── Collapse / Expand Toggle ── -->
            <Button fx:id="sidebarToggle" text="◀ Collapse"
                    maxWidth="Infinity" prefHeight="36"
                    styleClass="sidebar-toggle-btn"
                    onAction="#toggleSidebar"
                    pickOnBounds="true"
                    focusTraversable="false"/>

            <Region prefHeight="8"/>

            <!-- Footer -->
            <VBox fx:id="sidebarFooterBox" alignment="CENTER"
                  styleClass="sidebar-footer">
                <Label text="v1.0.0 · Nhóm 18" styleClass="sidebar-footer-label"/>
            </VBox>
        </VBox>
    </left>

    <!-- ════════════════ CENTER: Main Content ════════════════ -->
    <center>
        <StackPane fx:id="mainContentArea" styleClass="childpan"/>
    </center>
</BorderPane>
