<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="chatbotRoot" spacing="0" styleClass="childpan"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.training.studyfx.controller.ChatbotViewController">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="chat-header">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Chatbot AI" styleClass="chat-header-title"/>
            <Label text="Powered by Gemini" styleClass="chat-header-subtitle"/>
        </VBox>
        <Label text="AI Ready" styleClass="ai-badge"/>
    </HBox>

    <ScrollPane fx:id="chatbotScrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                styleClass="right-aligned-scrollpane">
        <content>
            <VBox fx:id="chatbotMessagesContainer" spacing="10" style="-fx-padding: 20 18 20 18;"/>
        </content>
    </ScrollPane>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="input-bar">
        <TextField fx:id="chatbotInput" promptText="Ask me anything..." HBox.hgrow="ALWAYS" styleClass="message-input"/>
        <Button text="Send" onAction="#handleSendMessage" styleClass="auth-btn-primary" prefWidth="120"/>
    </HBox>
</VBox>