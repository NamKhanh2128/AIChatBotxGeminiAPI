<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.training.studyfx.controller.ProfileSettingController"
            styleClass="childpan">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER_LEFT" prefHeight="58.0" styleClass="chat-header">
            <StackPane style="-fx-padding: 0 12 0 0;">
                <Circle radius="16" fill="rgba(255,255,255,0.07)"/>
                <Label text="⚙" style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.7);"/>
            </StackPane>
            <Label text="Settings" textFill="#FFFFFF">
                <font><Font name="Segoe UI Semibold" size="17.0"/></font>
            </Label>
        </HBox>

        <VBox alignment="CENTER" spacing="26" VBox.vgrow="ALWAYS">
            <VBox alignment="CENTER" spacing="14">
                <StackPane alignment="CENTER">
                    <Circle radius="62" fill="rgba(10,132,255,0.08)" stroke="rgba(10,132,255,0.25)" strokeWidth="1.5"/>
                    <Circle radius="56" fill="#2C2C2E" stroke="rgba(255,255,255,0.1)" strokeWidth="1.5"/>
                    <ImageView fx:id="profileImage" fitHeight="104.0" fitWidth="104.0" pickOnBounds="true" preserveRatio="true"/>
                </StackPane>
                <Button fx:id="changePhotoButton" text="Change Photo" prefHeight="36.0" minWidth="148.0" styleClass="change-photo-button"/>
            </VBox>

            <VBox maxWidth="520" alignment="CENTER" spacing="18" styleClass="profile-container">
                <Label text="Personal Information" styleClass="section-title"/>
                <GridPane hgap="14" vgap="14" alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="90.0"/>
                        <ColumnConstraints prefWidth="250.0" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Name" styleClass="form-label" GridPane.rowIndex="0"/>
                    <TextField fx:id="nameField" promptText="Your name" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Email" styleClass="form-label" GridPane.rowIndex="1"/>
                    <TextField fx:id="emailField" promptText="Your email" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Status" styleClass="form-label" GridPane.rowIndex="2"/>
                    <TextField fx:id="statusField" promptText="Your status" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <VBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 24 8 24;">
                    <Label text="Theme" styleClass="form-label"/>
                    <Label fx:id="themeStatusLabel" text="Current theme: dark" style="-fx-text-fill: rgba(255,255,255,0.65);"/>
                    <Button fx:id="themeToggleButton" text="Switch Theme" prefHeight="40.0" minWidth="200.0" styleClass="auth-btn-secondary"/>
                </VBox>

                <HBox spacing="12.0" alignment="CENTER">
                    <Button fx:id="saveButton" text="Save Changes" prefHeight="40.0" minWidth="148.0" styleClass="save-button"/>
                    <Button fx:id="logoutbutton" text="Log Out" prefHeight="40.0" minWidth="110.0" styleClass="auth-btn-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</AnchorPane>