<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.training.studyfx.controller.ProfileSettingController"
            styleClass="auth-container">

    <!-- Ambient glow blobs (same as RegisterView) -->
    <Circle radius="180" fill="rgba(139,92,246,0.08)"
             translateX="-70" translateY="-80"
             AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0"
             mouseTransparent="true"/>
    <Circle radius="120" fill="rgba(196,40,176,0.06)"
             AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"
             translateX="60" translateY="60"
             mouseTransparent="true"/>

    <!-- Scrollable center -->
    <ScrollPane fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <content>
            <VBox alignment="CENTER" minHeight="700" spacing="0">
                <VBox fx:id="settingsCard" alignment="CENTER" spacing="18"
                      styleClass="auth-card" maxWidth="400">

                    <!-- Icon + Avatar -->
                    <VBox alignment="CENTER" spacing="10">
                        <StackPane alignment="CENTER">
                            <!-- Outer glow ring -->
                            <Circle radius="44" fill="rgba(139,92,246,0.12)"
                                     stroke="rgba(139,92,246,0.3)" strokeWidth="1.5"/>
                            <!-- Gradient circle -->
                            <Circle radius="36"
                                     style="-fx-fill: linear-gradient(from 0% 0% to 100% 100%, #8b5cf6, #c428b0);
                                            -fx-effect: dropshadow(three-pass-box, rgba(139,92,246,0.6), 20, 0, 0, 0);"/>
                            <!-- Fallback icon (behind image) -->
                            <Label text="⚙" style="-fx-font-size: 26px; -fx-text-fill: white;
                                                     -fx-effect: dropshadow(three-pass-box, rgba(255,255,255,0.4), 6, 0, 0, 0);"/>
                            <!-- Profile image overlays icon when set -->
                            <ImageView fx:id="profileImage" fitHeight="52" fitWidth="52"
                                       pickOnBounds="true" preserveRatio="true"/>
                        </StackPane>
                        <Label text="Profile Settings" styleClass="auth-title"/>
                        <Label text="Update your personal information" styleClass="auth-subtitle"/>
                    </VBox>

                    <Rectangle height="1" width="300" fill="rgba(255,255,255,0.05)"/>

                    <!-- Name field -->
                    <VBox alignment="CENTER_LEFT" spacing="7">
                        <Label text="Name" styleClass="auth-label"/>
                        <TextField fx:id="nameField" promptText="Your full name"
                                   styleClass="auth-field" maxWidth="Infinity"/>
                    </VBox>

                    <!-- Email field -->
                    <VBox alignment="CENTER_LEFT" spacing="7">
                        <Label text="Email" styleClass="auth-label"/>
                        <TextField fx:id="emailField" promptText="Your email address"
                                   styleClass="auth-field" maxWidth="Infinity"/>
                    </VBox>

                    <!-- Status field -->
                    <VBox alignment="CENTER_LEFT" spacing="7">
                        <Label text="Status" styleClass="auth-label"/>
                        <TextField fx:id="statusField" promptText="What's your status?"
                                   styleClass="auth-field" maxWidth="Infinity"/>
                    </VBox>

                    <!-- Buttons -->
                    <VBox alignment="CENTER" spacing="10">
                        <Button fx:id="saveButton" defaultButton="true"
                                text="Save Changes"
                                prefHeight="48" maxWidth="Infinity"
                                styleClass="auth-btn-primary"/>
                        <Button fx:id="changePhotoButton"
                                text="📷  Change Photo"
                                prefHeight="44" maxWidth="Infinity"
                                styleClass="auth-btn-secondary"/>
                        <Button fx:id="logoutbutton"
                                text="← Log Out"
                                prefHeight="44" maxWidth="Infinity"
                                styleClass="auth-btn-secondary"/>
                    </VBox>

                    <!-- Theme toggle (subtle, at bottom) -->
                    <HBox alignment="CENTER">
                        <Button fx:id="themeToggleButton" text="🌓  Toggle Theme"
                                styleClass="auth-btn-secondary"
                                onAction="#toggleTheme"
                                style="-fx-padding: 6 16; -fx-font-size: 12px;
                                       -fx-background-radius: 10; -fx-border-radius: 10;"/>
                    </HBox>

                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
