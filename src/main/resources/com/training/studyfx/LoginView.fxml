<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.training.studyfx.controller.LoginController"
    styleClass="auth-container">

    <VBox alignment="CENTER"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox fx:id="loginCard" alignment="CENTER" spacing="20" styleClass="auth-card" maxWidth="420">
            <VBox alignment="CENTER" spacing="10">
                <StackPane alignment="CENTER">
                    <Circle radius="40" fill="rgba(59,130,246,0.12)" stroke="rgba(59,130,246,0.35)" strokeWidth="1.5"/>
                    <Circle radius="33" fill="#3B82F6"/>
                    <Label text="💬" style="-fx-font-size: 28px;"/>
                </StackPane>
                <Label text="Internal Chat" styleClass="auth-title"/>
                <Label text="Sign in to continue" styleClass="auth-subtitle"/>
            </VBox>
            <Rectangle height="1" width="320" fill="rgba(255,255,255,0.07)"/>
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Username" styleClass="auth-label"/>
                <TextField fx:id="usernameField" promptText="Enter your username" styleClass="auth-field"/>
            </VBox>
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Password" styleClass="auth-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="auth-field"/>
            </VBox>
            <Label fx:id="errorLabel" visible="false" wrapText="true" maxWidth="320" styleClass="auth-error"/>
            <VBox alignment="CENTER" spacing="12">
                <Button fx:id="loginButton" defaultButton="true" onAction="#handleLogin" text="Sign In" prefHeight="48" styleClass="auth-btn-primary"/>
                <Button fx:id="registerButton" onAction="#handleShowRegister" text="Create an Account" prefHeight="44" styleClass="auth-btn-secondary"/>
            </VBox>
            <Label text="Internal Chat · HUST OOP Project" style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
        </VBox>
    </VBox>
</AnchorPane>