<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox fx:id="chatbotRoot" spacing="0" styleClass="childpan"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.training.studyfx.controller.ChatbotViewController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="chat-header">
        <StackPane alignment="CENTER">
            <Circle radius="24"
                    style="-fx-fill: linear-gradient(from 0% 0% to 100% 100%, #7c3aed, #db2777);
                           -fx-effect: dropshadow(three-pass-box, rgba(124,58,237,0.45), 10, 0, 0, 0);"/>
            <Circle radius="20" style="-fx-fill: rgba(124,58,237,0.85);"/>
            <Label text="✨" style="-fx-font-size: 14px;"/>
        </StackPane>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Chatbot AI" styleClass="chat-header-title"/>
            <Label text="Powered by Gemini" styleClass="chat-header-subtitle"/>
        </VBox>
        <Label text="● AI Ready" styleClass="ai-badge"/>
    </HBox>

    <!-- Chat messages area -->
    <ScrollPane fx:id="chatbotScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                VBox.vgrow="ALWAYS" styleClass="right-aligned-scrollpane">
        <content>
            <VBox fx:id="chatbotMessagesContainer" spacing="10"
                  style="-fx-padding: 20 18 20 18;"/>
        </content>
    </ScrollPane>

    <!-- Input bar -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="input-bar">
        <TextField fx:id="chatbotInput" promptText="Ask me anything..."
                   HBox.hgrow="ALWAYS" styleClass="message-input"
                   onAction="#handleSendMessage"/>
        <Button onAction="#handleSendMessage" styleClass="send-btn"
                prefWidth="44" prefHeight="44" text="▶" focusTraversable="false"/>
    </HBox>
</VBox>
