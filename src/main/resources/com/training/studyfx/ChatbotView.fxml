package com.training.studyfx.controller;

import com.training.studyfx.service.GeminiService;
import javafx.application.Platform;
import javafx.fxml.FXML;
import javafx.scene.control.ScrollPane;
import javafx.scene.control.TextField;
import javafx.scene.layout.VBox;
import javafx.scene.control.Label;

public class ChatbotViewController {
    @FXML private ScrollPane chatbotScrollPane;
    @FXML private VBox chatbotMessagesContainer;
    @FXML private TextField chatbotInput;

    private final GeminiService gemini = new GeminiService();

    @FXML public void initialize() {
        addMessage("Chào bạn! Tôi là Chatbot cá nhân của bạn. Tôi có thể giúp gì cho bạn hôm nay?", true);
    }

    @FXML private void handleSendMessage() {
        String text = chatbotInput.getText().trim();
        if (text.isEmpty()) return;
        addMessage(text, false);
        chatbotInput.clear();
        addMessage("...", true);
        new Thread(() -> {
            String reply = gemini.generateResponse(text);
            Platform.runLater(() -> {
                removeLast();
                addMessage(reply, true);
            });
        }).start();
    }

    private void addMessage(String text, boolean bot) {
        Label msg = new Label(text);
        msg.setWrapText(true);
        msg.setMaxWidth(450);
        msg.getStyleClass().add(bot ? "bot-message" : "user-message");
        chatbotMessagesContainer.getChildren().add(msg);
        Platform.runLater(() -> chatbotScrollPane.setVvalue(1.0));
    }

    private void removeLast() {
        if (!chatbotMessagesContainer.getChildren().isEmpty())
            chatbotMessagesContainer.getChildren().remove(chatbotMessagesContainer.getChildren().size() - 1);
    }
}