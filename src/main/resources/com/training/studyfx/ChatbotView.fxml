<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="620.0" prefWidth="1060.0"
            stylesheets="@../../../styles/ui.css"
            style="-fx-background-color: #1C1C1E;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.training.studyfx.controller.ChatbotViewController">
   <children>
      <VBox spacing="0"
            AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
            AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

         <!-- ══ Header ══ -->
         <HBox alignment="CENTER_LEFT" spacing="14"
               style="-fx-background-color: #2C2C2E;
                      -fx-padding: 16 24 16 24;
                      -fx-border-width: 0 0 1 0;
                      -fx-border-color: rgba(255,255,255,0.06);">

            <!-- AI Avatar with amber glow -->
            <StackPane>
               <Circle radius="24" fill="rgba(245,158,11,0.15)"
                        stroke="rgba(245,158,11,0.35)" strokeWidth="1.5"/>
               <Circle radius="19" fill="#F59E0B"/>
               <Label text="✦" style="-fx-font-size: 15px; -fx-text-fill: white;"/>
            </StackPane>

            <VBox spacing="2">
               <Label text="Chatbot AI"
                      style="-fx-font-size: 16px; -fx-font-weight: bold;
                             -fx-text-fill: #FFFFFF;
                             -fx-font-family: 'Segoe UI Semibold', 'Segoe UI', sans-serif;"/>
               <Label text="Powered by Gemini"
                      style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.4);"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- AI Ready badge -->
            <HBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: rgba(245,158,11,0.1);
                         -fx-background-radius: 20px; -fx-padding: 5 14 5 14;
                         -fx-border-color: rgba(245,158,11,0.28);
                         -fx-border-radius: 20px; -fx-border-width: 1px;">
               <Circle radius="4" fill="#F59E0B"/>
               <Label text="AI Ready"
                      style="-fx-font-size: 12px; -fx-font-weight: bold;
                             -fx-text-fill: #F59E0B;"/>
            </HBox>
         </HBox>

         <!-- ══ Messages area ══ -->
         <ScrollPane fx:id="chatbotScrollPane" fitToWidth="true"
                     VBox.vgrow="ALWAYS"
                     styleClass="right-aligned-scrollpane"
                     style="-fx-background-color: transparent;
                            -fx-background: transparent;
                            -fx-border-color: transparent;">
            <content>
               <VBox fx:id="chatbotMessagesContainer" spacing="14.0"
                     style="-fx-background-color: transparent;">
                  <padding>
                     <Insets top="28" bottom="28" left="40" right="40"/>
                  </padding>
               </VBox>
            </content>
         </ScrollPane>

         <!-- ══ Input bar ══ -->
         <HBox alignment="CENTER" spacing="10"
               style="-fx-background-color: #2C2C2E;
                      -fx-padding: 14 20 14 20;
                      -fx-border-width: 1 0 0 0;
                      -fx-border-color: rgba(255,255,255,0.06);">

            <!-- Text input pill -->
            <TextField fx:id="chatbotInput"
                       promptText="Ask me anything…"
                       prefHeight="46.0"
                       style="-fx-background-color: rgba(255,255,255,0.07);
                              -fx-background-radius: 23px;
                              -fx-border-radius: 23px;
                              -fx-border-color: rgba(255,255,255,0.1);
                              -fx-border-width: 1px;
                              -fx-font-size: 14px;
                              -fx-padding: 0 22;
                              -fx-text-fill: #FFFFFF;
                              -fx-prompt-text-fill: rgba(255,255,255,0.35);
                              -fx-font-family: 'Segoe UI', sans-serif;"
                       HBox.hgrow="ALWAYS"/>

            <!-- Send button circle -->
            <StackPane alignment="CENTER"
                       onMouseClicked="#handleSendMessage"
                       style="-fx-cursor: hand;
                              -fx-background-color: #F59E0B;
                              -fx-background-radius: 50%;
                              -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.5), 10, 0, 0, 3);"
                       prefWidth="46" prefHeight="46">
               <ImageView fitHeight="20.0" fitWidth="20.0"
                          pickOnBounds="true" preserveRatio="true"
                          style="-fx-cursor: hand;">
                  <image><Image url="@../../../images/send_.png"/></image>
               </ImageView>
            </StackPane>
         </HBox>
      </VBox>
   </children>
</AnchorPane>