<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.Label?>

<Pane prefHeight="620.0" prefWidth="220.0"
      stylesheets="@../../../styles/ui.css"
      style="-fx-background-color: #1F1F21;
             -fx-border-width: 0 1 0 0;
             -fx-border-color: rgba(255,255,255,0.06);"
      xmlns="http://javafx.com/javafx/21.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.training.studyfx.controller.ListViewController">

    <children>
        <VBox prefHeight="620.0" prefWidth="220.0" spacing="0">
            <children>

                <!-- ── Panel title ── -->
                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 18 14 12 14;
                             -fx-border-width: 0 0 1 0;
                             -fx-border-color: rgba(255,255,255,0.06);">
                    <Circle radius="4" fill="#30D158"/>
                    <Label text="CONTACTS"
                           style="-fx-font-size: 10px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: rgba(255,255,255,0.3);
                                  -fx-font-family: 'Segoe UI', sans-serif;"/>
                </HBox>

                <!-- ── Search box ── -->
                <HBox alignment="CENTER" spacing="0"
                      style="-fx-padding: 10 10 6 10;">
                    <HBox alignment="CENTER" spacing="6"
                          style="-fx-background-color: rgba(255,255,255,0.07);
                                 -fx-background-radius: 12px;
                                 -fx-border-radius: 12px;
                                 -fx-border-color: rgba(255,255,255,0.08);
                                 -fx-border-width: 1px;
                                 -fx-padding: 6 12 6 12;"
                          HBox.hgrow="ALWAYS">
                        <Label text="🔍"
                               style="-fx-font-size: 12px;
                                      -fx-text-fill: rgba(255,255,255,0.3);"/>
                        <TextField fx:id="searchField"
                                   prefHeight="28.0"
                                   promptText="Search…"
                                   styleClass="search-input"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                </HBox>

                <!-- ── Filter tabs ── -->
                <HBox alignment="CENTER" spacing="8"
                      style="-fx-padding: 4 10 8 10;">
                    <Button fx:id="allChatsBtn"
                            mnemonicParsing="false"
                            text="All"
                            prefHeight="28" prefWidth="94"
                            style="-fx-background-color: #0A84FF;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 8;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;
                                   -fx-border-color: transparent;
                                   -fx-effect: dropshadow(gaussian, rgba(10,132,255,0.35), 6, 0, 0, 2);"/>
                    <Button fx:id="savedChatsBtn"
                            mnemonicParsing="false"
                            text="Saved"
                            prefHeight="28" prefWidth="94"
                            style="-fx-background-color: rgba(255,255,255,0.07);
                                   -fx-text-fill: rgba(255,255,255,0.55);
                                   -fx-background-radius: 8;
                                   -fx-font-size: 12px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.1);
                                   -fx-border-radius: 8;
                                   -fx-border-width: 1px;"/>
                </HBox>

                <!-- ── Chat list ── -->
                <ScrollPane fx:id="chatListScrollPane"
                            fitToWidth="true"
                            prefHeight="510.0" prefWidth="220.0"
                            styleClass="right-aligned-scrollpane"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="chatListContainer"
                              prefWidth="210.0"
                              spacing="2"
                              style="-fx-padding: 4 6 4 6;"/>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</Pane>
