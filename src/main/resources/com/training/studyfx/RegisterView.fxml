<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<ScrollPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.training.studyfx.controller.RegisterController"
            fitToWidth="true"
            styleClass="auth-container">

    <VBox alignment="CENTER" minHeight="560" spacing="0">
        <VBox fx:id="registerCard" alignment="CENTER" spacing="20" styleClass="auth-card" maxWidth="420">
            <VBox alignment="CENTER" spacing="10">
                <StackPane alignment="CENTER">
                    <Circle radius="40" fill="rgba(139,92,246,0.12)" stroke="rgba(139,92,246,0.35)" strokeWidth="1.5"/>
                    <Circle radius="33" fill="#8B5CF6"/>
                    <Label text="✨" style="-fx-font-size: 26px;"/>
                </StackPane>
                <Label text="Create Account" styleClass="auth-title"/>
                <Label text="Join Internal Chat today" styleClass="auth-subtitle"/>
            </VBox>
            <Rectangle height="1" width="320" fill="rgba(255,255,255,0.07)"/>
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Username" styleClass="auth-label"/>
                <TextField fx:id="usernameField" promptText="Choose a username" styleClass="auth-field"/>
            </VBox>
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Email" styleClass="auth-label"/>
                <TextField fx:id="emailField" promptText="Enter your email" styleClass="auth-field"/>
            </VBox>
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Password" styleClass="auth-label"/>
                <PasswordField fx:id="passwordField" promptText="Create a password" styleClass="auth-field"/>
            </VBox>
            <VBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Confirm Password" styleClass="auth-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm your password" styleClass="auth-field"/>
            </VBox>
            <Label fx:id="errorLabel" visible="false" wrapText="true" maxWidth="320" styleClass="auth-error"/>
            <VBox alignment="CENTER" spacing="12">
                <Button fx:id="registerButton" defaultButton="true" onAction="#handleRegister" text="Create Account" prefHeight="48" styleClass="auth-btn-primary"/>
                <Button fx:id="backToLoginButton" onAction="#handleBackToLogin" text="Back to Login" prefHeight="44" styleClass="auth-btn-secondary"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>